{
  "name": "nominaconnect",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "bin": {
    "nomina": "./bin/nomina.js"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "build:native": "bun build --compile --outfile dist/nomina bin/nomina.js",
    "build:node": "cp bin/nomina.js dist/nomina.js && chmod +x dist/nomina.js",
    "build:all": "bun run build:native && bun run build:node"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  }
}
